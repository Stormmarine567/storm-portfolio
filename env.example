# Supabase: Project URL from the "Connect" button; key from Settings -> API Keys
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Use the SECRET key (sb_secret_...) or the legacy service_role key. Never put it in the browser.
SUPABASE_SERVICE_KEY=sb_secret_your-key

# Admin panel login
ADMIN_PASSWORD=choose-a-strong-password
# Any long random string, used to sign admin session tokens (e.g. run: openssl rand -hex 32)
ADMIN_TOKEN_SECRET=replace-with-a-long-random-string
